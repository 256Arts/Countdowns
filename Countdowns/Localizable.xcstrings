    "Now let's celebrate by adding the event through the \"+\" menu, and trying out the new features!" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Feiern wir jetzt, indem du über das „+“-Menü ein Ereignis hinzufügst und die neuen Funktionen ausprobierst!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "¡Celébralo añadiendo el evento desde el menú \"+\" y prueba las nuevas funciones!"
