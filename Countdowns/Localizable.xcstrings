    "The most units shown together. Short names are used when several share a line." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die meisten gleichzeitig angezeigten Einheiten. Wenn sich mehrere eine Zeile teilen, werden Kurznamen verwendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La cantidad máxima de unidades que se muestran juntas. Se usan nombres cortos cuando varias comparten una línea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le nombre maximal d'unités affichées ensemble. Des noms courts sont utilisés lorsque plusieurs unités partagent une ligne."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "同時に表示される単位の最大数です。複数の単位が1行に収まる場合は短い名前が使用されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "同时显示的最多单位数。多个单位共享一行时会使用简短名称。"
          }
        }
      }
    },
